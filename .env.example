# 颜听运行配置示例
# 复制到 services/api/.env，填写本机模型凭证。
# 键与 services/api/app/config.py 的字段一一对应（前缀 ANKER_AGENT_）。

# ---------------------------------------------------------------------------
# 运行模式
#   live —— 使用真实模型服务与真实索引（默认）
#   mock —— 仅用于自动化测试与早期联调，不得作为验收依据
# ---------------------------------------------------------------------------
ANKER_AGENT_RUN_MODE=live

# 监听地址（默认只绑定本机回环，公网发布需另行确认）
ANKER_AGENT_API_HOST=127.0.0.1
ANKER_AGENT_API_PORT=8000

# 允许的前端来源（逗号分隔）
ANKER_AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 单张上传图片上限（字节，默认 5 MB）与允许的 MIME 类型
ANKER_AGENT_IMAGE_MAX_BYTES=5242880
ANKER_AGENT_IMAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---------------------------------------------------------------------------
# 文本/多模态模型（OpenAI 兼容 /chat/completions）
# 未配置时 live 模式会在健康检查中报告 model_provider=unavailable，
# 不会静默回退为固定回复。
# ---------------------------------------------------------------------------
ANKER_AGENT_LLM_BASE_URL=
ANKER_AGENT_LLM_API_KEY=
ANKER_AGENT_LLM_MODEL=
ANKER_AGENT_LLM_VISION_MODEL=
ANKER_AGENT_LLM_VISION_BASE_URL=
ANKER_AGENT_LLM_VISION_API_KEY=
ANKER_AGENT_LLM_FAST_MODEL=
ANKER_AGENT_LLM_TIMEOUT_SECONDS=60

# AI 接待模式下等待自动回复的超时（秒）
ANKER_AGENT_AUTO_REPLY_TIMEOUT_SECONDS=45

# 服务预警 Demo 阈值，0 可分别停用；不代表生产 SLA。
ANKER_AGENT_RISK_RESPONSE_WAIT_SECONDS=120
ANKER_AGENT_RISK_FOLLOWUP_WARNING_MINUTES=30
ANKER_AGENT_RISK_MONITOR_INTERVAL_SECONDS=15
ANKER_AGENT_RISK_REPEAT_CONTACT_HOURS=72
ANKER_AGENT_RISK_SOURCE_TICKET_HOURS=48

# ---------------------------------------------------------------------------
# 编码模型（稠密 + 稀疏两通道）
#   onnx-local —— 本地 ONNX bge-m3（默认，无外部依赖）
#   http       —— 比赛/第三方提供的 OpenAI 兼容 embeddings 服务
#   mock       —— 仅测试用确定性伪向量
# ---------------------------------------------------------------------------
ANKER_AGENT_EMBEDDING_BACKEND=onnx-local
ANKER_AGENT_EMBEDDING_MODEL_ID=BAAI/bge-m3
ANKER_AGENT_EMBEDDING_MODEL_PATH=
ANKER_AGENT_EMBEDDING_HTTP_BASE_URL=
ANKER_AGENT_EMBEDDING_HTTP_API_KEY=
ANKER_AGENT_EMBEDDING_DIMENSION=

# ---------------------------------------------------------------------------
# 重排模型（可选）
#   none —— 关闭重排（默认）；此时候选只按稠密/稀疏融合排序
#   http —— OpenAI 兼容 rerank 服务
#   mock —— 仅测试用确定性排序
# ---------------------------------------------------------------------------
ANKER_AGENT_RERANK_BACKEND=none
ANKER_AGENT_RERANK_BASE_URL=
ANKER_AGENT_RERANK_API_KEY=
ANKER_AGENT_RERANK_MODEL=
ANKER_AGENT_RERANK_TIMEOUT_SECONDS=30
ANKER_AGENT_RERANK_CANDIDATES=16

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
ANKER_AGENT_DATABASE_URL=sqlite+pysqlite:///data/runtime/anker_agent.sqlite3
ANKER_AGENT_QDRANT_PATH=data/runtime/qdrant
ANKER_AGENT_RUNTIME_DIR=data/runtime

# 知识切片（字符计数，非 token）
ANKER_AGENT_CHUNK_SIZE=600
ANKER_AGENT_CHUNK_OVERLAP=80
ANKER_AGENT_CHUNK_CONFIG_VERSION=chunk-600-80-v1
ANKER_AGENT_RETRIEVAL_TOP_K=8
ANKER_AGENT_RETRIEVAL_MAX_EVIDENCE=5

# ---------------------------------------------------------------------------
# 内部版本标记，用于契约与提示词追踪，一般不改
# ---------------------------------------------------------------------------
ANKER_AGENT_CONTRACT_VERSION=0.1.0
ANKER_AGENT_PROMPT_VERSION=s0-bootstrap
