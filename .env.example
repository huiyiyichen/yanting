# 颜听运行配置示例
# 复制到 services/api/.env，填写本机模型凭证。
# 键与 services/api/app/config.py 的字段一一对应（前缀 YANTING_）。
# 旧前缀 ANKER_AGENT_ 过渡期仍可读取（启动日志会提示改名），新前缀优先。

# ---------------------------------------------------------------------------
# 运行模式
#   live —— 使用真实模型服务与真实索引（默认）
#   mock —— 仅用于自动化测试与早期联调，不得作为验收依据
# ---------------------------------------------------------------------------
YANTING_RUN_MODE=live

# 监听地址（默认只绑定本机回环，公网发布需另行确认）
YANTING_API_HOST=127.0.0.1
YANTING_API_PORT=8000

# 允许的前端来源（逗号分隔）
YANTING_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 单张上传图片上限（字节，默认 5 MB）与允许的 MIME 类型
YANTING_IMAGE_MAX_BYTES=5242880
YANTING_IMAGE_ALLOWED_MIME=image/jpeg,image/png,image/webp

# ---------------------------------------------------------------------------
# 文本/多模态模型（OpenAI 兼容 /chat/completions）
# 未配置时 live 模式会在健康检查中报告 model_provider=unavailable，
# 不会静默回退为固定回复。
# ---------------------------------------------------------------------------
YANTING_LLM_BASE_URL=
YANTING_LLM_API_KEY=
YANTING_LLM_MODEL=
YANTING_LLM_VISION_MODEL=
YANTING_LLM_VISION_BASE_URL=
YANTING_LLM_VISION_API_KEY=
YANTING_LLM_FAST_MODEL=
YANTING_LLM_TIMEOUT_SECONDS=60

# AI 接待模式下等待自动回复的超时（秒）
YANTING_AUTO_REPLY_TIMEOUT_SECONDS=45

# 编排方式：multi=多 Agent 编排（默认）；single=单图（仅用于对比）
YANTING_ORCHESTRATION=multi

# 服务预警 Demo 阈值，0 可分别停用；不代表生产 SLA。
YANTING_RISK_RESPONSE_WAIT_SECONDS=120
YANTING_PANORAMA_ACTIVE_WINDOW_MINUTES=120
YANTING_RISK_FOLLOWUP_WARNING_MINUTES=30
YANTING_RISK_MONITOR_INTERVAL_SECONDS=15
YANTING_RISK_REPEAT_CONTACT_HOURS=72
# 只有寒暄、共情、补问的回复跳过模型核验；false 恢复每次核验
YANTING_VERIFY_ON_DEMAND=true
# 模型价格表（每百万 Token 元），留空则不估算成本，例：{"deepseek-chat":{"input":2,"cachedInput":0.5,"output":8}}
# 元/百万 Token，取 DeepSeek 官方高峰价（2026-10-16 api-docs.deepseek.com/zh-cn/quick_start/pricing；空闲时段减半）
YANTING_MODEL_PRICES_JSON={"deepseek-flash":{"input":2,"cachedInput":0.04,"output":8}}
YANTING_RISK_SOURCE_TICKET_HOURS=48

# ---------------------------------------------------------------------------
# 编码模型（稠密 + 稀疏两通道）
#   onnx-local —— 本地 ONNX bge-m3（默认，无外部依赖）
#   http       —— 比赛/第三方提供的 OpenAI 兼容 embeddings 服务
#   mock       —— 仅测试用确定性伪向量
# ---------------------------------------------------------------------------
YANTING_EMBEDDING_BACKEND=onnx-local
YANTING_EMBEDDING_MODEL_ID=BAAI/bge-m3
YANTING_EMBEDDING_MODEL_PATH=
YANTING_EMBEDDING_HTTP_BASE_URL=
YANTING_EMBEDDING_HTTP_API_KEY=
YANTING_EMBEDDING_DIMENSION=

# ---------------------------------------------------------------------------
# 重排模型（可选）
#   none —— 关闭重排（默认）；此时候选只按稠密/稀疏融合排序
#   http —— OpenAI 兼容 rerank 服务
#   mock —— 仅测试用确定性排序
# ---------------------------------------------------------------------------
YANTING_RERANK_BACKEND=none
YANTING_RERANK_BASE_URL=
YANTING_RERANK_API_KEY=
YANTING_RERANK_MODEL=
YANTING_RERANK_TIMEOUT_SECONDS=30
YANTING_RERANK_CANDIDATES=16

# ---------------------------------------------------------------------------
# 存储
# ---------------------------------------------------------------------------
YANTING_DATABASE_URL=sqlite+pysqlite:///data/runtime/yanting.sqlite3
YANTING_QDRANT_PATH=data/runtime/qdrant
YANTING_RUNTIME_DIR=data/runtime

# 知识切片（字符计数，非 token）
YANTING_CHUNK_SIZE=600
YANTING_CHUNK_OVERLAP=80
YANTING_CHUNK_CONFIG_VERSION=chunk-600-80-v1
YANTING_RETRIEVAL_TOP_K=8
YANTING_RETRIEVAL_MAX_EVIDENCE=5

# ---------------------------------------------------------------------------
# 内部版本标记，用于契约与提示词追踪，一般不改
# ---------------------------------------------------------------------------
YANTING_CONTRACT_VERSION=0.1.0
YANTING_PROMPT_VERSION=s0-bootstrap
