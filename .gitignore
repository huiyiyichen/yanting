data/normalized/

# 本地知识索引与模型缓存
data/index/
.cache/

# 环境变量与密钥（.env 的任何备份/变体都不入库：实测 .env.bak-vision 曾落在忽略规则之外）
.env
.env.local
*.local.env
.env.bak*
.env.*.bak
.env.*
!.env.example

